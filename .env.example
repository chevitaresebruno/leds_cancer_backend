# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://host.docker.internal

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Image token (HMAC) ───────────────────────────────────────────────────────
# Chave dedicada para assinar tokens de acesso a imagens (recomendado).
# Se omitida, usa SECRET_KEY como fallback.
IMAGE_TOKEN_SECRET=your-image-token-secret-here
# Tempo de vida do token em segundos (padrão: 900 = 15 min)
IMAGE_TOKEN_TTL_SECONDS=900


# ─── AI API ───────────────────────────────────────────────────────
AI_API_BASE_URL=http://localhost:8000/api/v1/
AI_API_TOKEN=Bearer dev-token
